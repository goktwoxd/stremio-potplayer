{
  "manifest_version": 3,
  "name": "PotPlayer launcher for Stremio",
  "version": "1.0.1",
  "description": "Adds a one-click handoff from Stremio Web's Copy stream link action to PotPlayer on Windows.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://web.stremio.com/*"],
      "js": ["labels.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
