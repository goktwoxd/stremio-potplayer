{
  "manifest_version": 3,
  "name": "Stremio to PotPlayer",
  "version": "1.0.0",
  "description": "Click \"Copy Stream Link\" in Stremio and play the stream in PotPlayer.",
  "permissions": ["clipboardRead"],
  "content_scripts": [
    {
      "matches": ["https://web.stremio.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
